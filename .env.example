# 百度网盘批量重命名工具配置。真实 .env 已被 Git 忽略。
# 从百度网盘开放平台 OAuth 授权获取；不要提交、分享或写入日志。
BAIDU_NETDISK_ACCESS_TOKEN=

# 默认按 1 秒一次请求执行，滚动一小时最多 3600 次。
# 未审核应用官方默认频率为 10 次/小时；若应用尚未通过上线审核，请改为 6m/8。
BAIDU_NETDISK_REQUEST_INTERVAL=1s
BAIDU_NETDISK_MAX_REQUESTS_PER_HOUR=3600

# 单次最多生成的重命名计划数（硬上限 10000），仍受请求预算约束。
BAIDU_NETDISK_MAX_RENAMES=1500
BAIDU_NETDISK_TIMEOUT=30s
